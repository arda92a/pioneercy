server {
    listen 80;
    listen [::]:80;
    server_name pioneercy.com www.pioneercy.com;

    # Redirect HTTP to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name pioneercy.com www.pioneercy.com;

    ssl_certificate /etc/letsencrypt/live/pioneercy.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pioneercy.com/privkey.pem;

    # Upload boyutu
    client_max_body_size 10M;

    # Next.js uygulamasına yönlendir
    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Static dosyalar
    location /_next/static {
        proxy_pass http://localhost:3000;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Yüklenen görseller
    location /uploads {
        proxy_pass http://localhost:3000;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
